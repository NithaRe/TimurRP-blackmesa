bm-car-verb-drive = Get in (driver)
bm-car-verb-ride = Get in (passenger)
bm-car-verb-pull-out = Pull everyone out

bm-car-driver-taken = The driver's seat is taken.
bm-car-no-seats = No free seats.
bm-car-being-put-in = { CAPITALIZE(THE($user)) } is putting you into the car!
bm-car-being-pulled-out = { CAPITALIZE(THE($user)) } is trying to pull you out of the car!
bm-car-entered-driver = You are behind the wheel. Start the engine, WASD to drive, Shift to go slow.
bm-car-entered-passenger = You take the passenger seat.

bm-car-engine-starting = You turn the key...
bm-car-engine-running = The engine roars to life.
bm-car-engine-off = You shut the engine off.

bm-car-ram = { CAPITALIZE(THE($car)) } rams { THE($victim) }!
bm-car-run-over = { CAPITALIZE(THE($car)) } runs over { THE($victim) }!
bm-car-crash = Crash! The car slams into an obstacle.

bm-car-control-car = Steering: car-relative (W - gas, S - brake/reverse, A/D - steer).
bm-car-control-screen = Steering: screen-relative.
