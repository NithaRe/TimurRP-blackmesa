cmd-setnametag-desc = Накладывает красивый текст над персонажем игрока. Без текста - убирает тег.
cmd-setnametag-help = setnametag <ckey> ["текст"] [#цвет] [norainbow] [rune|flame|orbit]

cmd-setnametag-error-usage = Использование: { $help }
cmd-setnametag-error-player-not-found = Игрок { $name } не найден.
cmd-setnametag-error-no-entity = У игрока нет прикреплённой сущности.
cmd-setnametag-error-bad-color = Неверный цвет: { $color }
cmd-setnametag-error-unknown-arg = Неизвестный аргумент: { $arg }

cmd-setnametag-removed = Тег убран у { $name }.
cmd-setnametag-set = Тег установлен для { $name }.

cmd-setnametag-hint-ckey = <ckey>
cmd-setnametag-hint-text = "текст"
cmd-setnametag-hint-options = [#цвет] [norainbow] [rune | flame | orbit]
