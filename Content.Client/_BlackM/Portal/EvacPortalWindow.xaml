<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'evac-portal-window-title'}"
    MinWidth="340"
    MinHeight="300"
    SetSize="340 360">

    <BoxContainer Orientation="Vertical" Margin="8">

        <PanelContainer StyleClasses="WindowHeadingBackground" Margin="0 0 0 6">
            <Label Text="{Loc 'evac-portal-window-heading'}"
                   StyleClasses="FancyWindowTitle"
                   Margin="8 4"
                   HorizontalAlignment="Center" />
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" Margin="0 4" HorizontalExpand="True">
            <Label Text="{Loc 'evac-portal-label-status'}"
                   StyleClasses="LabelSubText"
                   Margin="0 0 8 0"
                   VerticalAlignment="Center" />
            <Label Name="StatusLabel"
                   Text="---"
                   HorizontalExpand="True"
                   VerticalAlignment="Center" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="0 4" />

        <Label Text="{Loc 'evac-portal-label-energy'}"
               StyleClasses="LabelSubText"
               Margin="0 4 0 2" />

        <BoxContainer Orientation="Horizontal" Margin="0 0 0 2">
            <ProgressBar Name="EnergyBar"
                         MinValue="0"
                         MaxValue="1"
                         Value="0"
                         HorizontalExpand="True"
                         MinHeight="18"
                         Margin="0 0 6 0" />
            <Label Name="EnergyLabel"
                   Text="0%"
                   MinWidth="36"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="0 8" />

        <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" Margin="0 0 0 8">
            <Label Name="TimerHeaderLabel"
                   Text=""
                   StyleClasses="LabelSubText"
                   HorizontalAlignment="Center"
                   Visible="False" />
            <Label Name="TimerLabel"
                   Text="00:00"
                   StyleClasses="FancyWindowTitle"
                   HorizontalAlignment="Center"
                   Visible="False" />
        </BoxContainer>

        <Button Name="LaunchButton"
                Text="{Loc 'evac-portal-button-start-sync'}"
                HorizontalExpand="True"
                MinHeight="36"
                Margin="0 4 0 0" />

        <Button Name="TeleportButton"
                Text="{Loc 'evac-portal-button-teleport'}"
                HorizontalExpand="True"
                MinHeight="36"
                Margin="0 4 0 0"
                Visible="False" />

    </BoxContainer>
</controls:FancyWindow>
