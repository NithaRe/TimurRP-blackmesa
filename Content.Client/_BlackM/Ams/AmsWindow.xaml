<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'ams-ui-title'}"
                      MinSize="520 580"
                      SetSize="540 620">
    <PanelContainer Name="RootPanel">
        <BoxContainer Orientation="Vertical" Margin="22 20 22 22" SeparationOverride="12">
            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="16 10 16 10" SeparationOverride="12">
                    <TextureRect Name="Logo" VerticalAlignment="Center"/>
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center">
                        <Label Name="StatusLabel" StyleClasses="LabelBig"/>
                        <Label Name="HintLabel" StyleClasses="LabelSubText"/>
                    </BoxContainer>
                    <Label Name="TimerLabel" StyleClasses="LabelBig" VerticalAlignment="Center"/>
                </BoxContainer>
            </PanelContainer>
            <TextureRect Name="Hazard"/>
            <BoxContainer Orientation="Vertical" SeparationOverride="4">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'ams-ui-charge'}" StyleClasses="LabelSubText" HorizontalExpand="True"/>
                    <Label Name="ChargeLabel"/>
                </BoxContainer>
                <ProgressBar Name="ChargeBar" MinValue="0" MaxValue="1" MinHeight="22"/>
            </BoxContainer>
            <Label Text="{Loc 'ams-ui-parts'}" StyleClasses="LabelSubText"/>
            <GridContainer Name="PartsGrid" Columns="2" HSeparationOverride="8" VSeparationOverride="8"/>
            <Control VerticalExpand="True"/>
            <Button Name="ActionButton" MinHeight="50"/>
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
