<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'ams-ui-title'}"
                      MinSize="540 530"
                      SetSize="560 550">
    <BoxContainer Orientation="Vertical" Margin="10 8 10 10" SeparationOverride="8">
        <!-- Шапка: состояние, таймер, подсказка -->
        <PanelContainer Name="HeaderPanel">
            <BoxContainer Orientation="Vertical" Margin="10 6 10 8" SeparationOverride="2">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'ams-ui-status'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                    <Label Name="TimerCaption" StyleClasses="LabelSubText" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Label Name="StatusLabel" StyleClasses="LabelBig" HorizontalExpand="True" />
                    <Label Name="TimerLabel" StyleClasses="LabelBig" />
                </BoxContainer>
                <RichTextLabel Name="HintLabel" Margin="0 2 0 0" />
            </BoxContainer>
        </PanelContainer>

        <!-- Заряд -->
        <BoxContainer Orientation="Vertical" SeparationOverride="3">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'ams-ui-charge'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                <Label Name="ChargeLabel" />
            </BoxContainer>
            <ProgressBar Name="ChargeBar" MinValue="0" MaxValue="1" MinHeight="20" />
        </BoxContainer>

        <!-- Компоненты -->
        <BoxContainer Orientation="Vertical" SeparationOverride="4">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'ams-ui-parts'}" StyleClasses="LabelSubText" HorizontalExpand="True" />
                <Label Name="PartsCountLabel" StyleClasses="LabelSubText" />
            </BoxContainer>
            <PanelContainer StyleClasses="LowDivider" />
            <GridContainer Name="PartsGrid" Columns="2" HSeparationOverride="6" VSeparationOverride="6" />
        </BoxContainer>

        <!-- Образец -->
        <PanelContainer Name="SamplePanel">
            <BoxContainer Orientation="Horizontal" Margin="10 6 10 6" SeparationOverride="8">
                <Label Text="{Loc 'ams-ui-sample'}" StyleClasses="LabelSubText" />
                <Label Name="SampleLabel" HorizontalExpand="True" />
            </BoxContainer>
        </PanelContainer>

        <Control VerticalExpand="True" />
        <Button Name="ActionButton" MinHeight="40" />
    </BoxContainer>
</controls:FancyWindow>
