<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:terminal="clr-namespace:Content.Client._BlackM.Lobby.Terminal"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <terminal:TerminalGridBackground Name="BackgroundGrid" />
    <terminal:TerminalBackgroundFx Name="BackgroundFx" />

    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="10 10 10 10" SeparationOverride="2">
        <SplitContainer State="Auto" ResizeMode="NotResizable" HorizontalExpand="True">
            <!-- LHS Controls -->
            <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                <Control Name="DefaultState" VerticalExpand="True">
                    <BoxContainer Name="TopLeft" Orientation="Vertical">
                        <PanelContainer StyleClasses="PanelTerminalBlackM" HorizontalAlignment="Left"
                                        Name="LeftSideTop" VerticalAlignment="Top">
                            <BoxContainer Orientation="Vertical" MaxWidth="800" SeparationOverride="6">
                                <terminal:TerminalTypewriterLabel Name="TerminalHeader" Access="Public"
                                                                  StyleClasses="LabelTerminalBlackM"
                                                                  HorizontalAlignment="Left" />
                                <controls:HLine Color="{x:Static style:StyleNano.TerminalGreenDim}" Thickness="1" />
                                <info:LinkBanner Name="LinkBanner" VerticalExpand="false" HorizontalAlignment="Left"
                                                 Margin="3 3 3 3" />
                                <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="3 3 3 3">
                                    <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                        Text="{Loc 'ui-lobby-observe-button'}"
                                                        StyleClasses="ButtonTerminalBlackM"
                                                        WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                    <Label Name="StartTime"
                                           Access="Public"
                                           Align="Left"
                                           StyleClasses="LabelTerminalBlackM"
                                           HorizontalExpand="True" />
                                    <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                            Text="{Loc 'ui-lobby-ready-up-button'}"
                                            StyleClasses="ButtonTerminalBlackM" MinWidth="137" />
                                </BoxContainer>
                                <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public"
                                               HorizontalAlignment="Left" />
                            </BoxContainer>
                        </PanelContainer>
                        <!-- Voting Popups -->
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                                      Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0 8" />
                    </BoxContainer>

                    <terminal:TerminalHub Name="Hub" Access="Public" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Margin="270 40 0 0" />

                    <terminal:TerminalLogFeed HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                              Margin="24 0 0 70" />

                    <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Center"
                                  SeparationOverride="20" Margin="24 0 0 0">
                        <terminal:TerminalMenu Name="Menu" Access="Public" Orientation="Vertical"
                                               SeparationOverride="8" MinWidth="230">
                            <Button Name="OptionsButton" Access="Public" StyleClasses="ButtonTerminalBlackM"
                                    Text="{Loc 'ui-lobby-options-button'}" />
                            <Button Name="AHelpButton" Access="Public" StyleClasses="ButtonTerminalBlackM"
                                    Text="{Loc 'ui-lobby-ahelp-button'}" />
                            <vote:VoteCallMenuButton Name="CallVoteButton" StyleClasses="ButtonTerminalBlackM" />
                            <Button Name="LeaveButton" Access="Public" StyleClasses="ButtonTerminalBlackM"
                                    Text="{Loc 'ui-lobby-leave-button'}" />
                            <Button Name="DiscordButton" Access="Public" StyleClasses="ButtonTerminalBlackM">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                    <TextureRect TexturePath="/Textures/_BlackM/Interface/Icons/discord.png"
                                                 MinSize="22 22" Stretch="KeepAspectCentered"
                                                 VerticalAlignment="Center" />
                                    <Label Text="Discord" VAlign="Center" StyleClasses="LabelTerminalBlackM" />
                                </BoxContainer>
                            </Button>
                            <Button Name="BoustyButton" Access="Public" StyleClasses="ButtonTerminalBlackM">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                    <TextureRect TexturePath="/Textures/_BlackM/Interface/Icons/boosty.png"
                                                 MinSize="22 22" Stretch="KeepAspectCentered"
                                                 VerticalAlignment="Center" />
                                    <Label Text="Boosty" VAlign="Center" StyleClasses="LabelTerminalBlackM" />
                                </BoxContainer>
                            </Button>
                        </terminal:TerminalMenu>
                        <BoxContainer Name="ServerSocialPanel" Orientation="Vertical" SeparationOverride="8">
                            <RichTextLabel Name="ServerInfoText" Access="Public" />
                        </BoxContainer>
                    </BoxContainer>

                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  SeparationOverride="4">
                        <info:DevInfoBanner Name="DevInfoBanner" VerticalExpand="false" Margin="3 3 3 3" />
                        <PanelContainer StyleClasses="PanelTerminalBlackM">
                            <RichTextLabel Name="LobbySong" Access="Public" HorizontalAlignment="Center" />
                        </PanelContainer>
                    </BoxContainer>
                </Control>
                <!-- Character setup state -->
                <!-- This is injected on startup. Funky! -->
                <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
            </BoxContainer>

            <!-- Right Panel -->
            <PanelContainer Name="RightSide" Access="Public" StyleClasses="PanelTerminalBlackM"
                            HorizontalAlignment="Right" VerticalExpand="True" VerticalAlignment="Stretch">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <!-- Top row -->
                    <BoxContainer Orientation="Horizontal" MinSize="0 40" Name="HeaderContainer" Access="Public"
                                  SeparationOverride="4">
                        <Label Name="ServerName" Access="Public" StyleClasses="LabelTerminalBlackM" VAlign="Center"
                               HorizontalExpand="True" HorizontalAlignment="Center" />
                    </BoxContainer>
                    <controls:HLine Color="{x:Static style:StyleNano.TerminalGreenDim}" Thickness="2" />
                    <controls:HSpacer Spacing="10" />
                    <PanelContainer Margin="3">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#030A05CC"
                                              BorderColor="{x:Static style:StyleNano.TerminalGreenDim}"
                                              BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="8">
                            <BoxContainer Orientation="Horizontal">
                                <Label Text="{Loc 'blackm-serverinfo-title'}" StyleClasses="LabelTerminalBlackM"
                                       HorizontalExpand="True" />
                                <Label Text="{Loc 'blackm-serverinfo-online'}" StyleClasses="LabelTerminalBlackM"
                                       Modulate="#FFFFFFA0" />
                            </BoxContainer>
                            <controls:HLine Color="{x:Static style:StyleNano.TerminalGreenDim}" Thickness="1" />
                            <info:ServerInfo Name="ServerInfo" Access="Public" MinSize="0 30" VerticalExpand="false"
                                             Margin="2 2 2 2" MaxWidth="560" HorizontalAlignment="Left" />
                            <Label Name="StationTime" Access="Public" StyleClasses="LabelTerminalBlackM"
                                   Margin="2 2 2 2" HorizontalAlignment="Left" />
                        </BoxContainer>
                    </PanelContainer>
                    <controls:HSpacer Spacing="6" />
                    <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" Margin="3" />
                    <controls:HSpacer Spacing="5" />
                    <BoxContainer MinHeight="10" />
                    <!-- Server Currency -->
                    <Label Name="Balance" Access="Public" StyleClasses="LabelTerminalBlackM" VAlign="Center"
                           HorizontalExpand="True" HorizontalAlignment="Center" />
                    <controls:HLine Color="{x:Static style:StyleNano.TerminalGreenDim}" Thickness="2" Access="Public" />
                    <controls:HSpacer Spacing="10" />
                    <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" Margin="3 3 3 3" MinHeight="50" />
                </BoxContainer>
                <TextureButton Name="CollapseButton"
                               TexturePath="filled_right_arrow.svg.192dpi"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0 2 2 0"
                               ModulateSelfOverride="{x:Static style:StyleNano.TerminalGreen}"
                               Scale="0.5 0.5"/>
            </PanelContainer>
        </SplitContainer>
        <PanelContainer Name="ExpandPanel"
                        StyleClasses="PanelTerminalBlackM"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 2 2 0"
                        Visible="False">
            <TextureButton Name="ExpandButton"
                           TexturePath="filled_left_arrow.svg.192dpi"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           ModulateSelfOverride="{x:Static style:StyleNano.TerminalGreen}"
                           Scale="0.5 0.5"/>
        </PanelContainer>
    </BoxContainer>

    <terminal:TerminalScanlines Name="Scanlines" />
    <terminal:TerminalBootOverlay Name="BootOverlay" />
<!-- BlackM end -->
</lobbyUi:LobbyGui>
