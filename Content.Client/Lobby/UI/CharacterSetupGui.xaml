<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:style="clr-namespace:Content.Client.Stylesheets"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:terminal="clr-namespace:Content.Client._BlackM.Lobby.Terminal"
         VerticalExpand="True">
<!-- BlackM end -->
    <Control>
        <PanelContainer Name="BackgroundPanel" />
        <BoxContainer Orientation="Vertical" SeparationOverride="0">
            <BoxContainer Orientation="Horizontal" MinSize="0 40">
                <!-- BlackM start -->
                <!--
                <Label Text="{Loc 'character-setup-gui-character-setup-label'}"
                       Margin="8 0 0 0" VAlign="Center"
                       StyleClasses="LabelHeadingBigger" />

                <Button Name="StatsButton" HorizontalExpand="True"
                        Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
                        StyleClasses="ButtonBig"
                        HorizontalAlignment="Right" />
                <cc:CommandButton Name="AdminRemarksButton"
                                  Command="adminremarks"
                                  Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                  StyleClasses="ButtonBig" />
                -->
                <terminal:TerminalTypewriterLabel Name="TitleLabel"
                       Text="{Loc 'character-setup-gui-character-setup-label'}"
                       Margin="10 0 0 0" VAlign="Center" HorizontalExpand="True"
                       StyleClasses="LabelTerminalBlackM" />

                <Button Name="StatsButton"
                        Text="{Loc 'character-setup-gui-character-setup-stats-button'}"
                        StyleClasses="ButtonTerminalBlackM"
                        HorizontalAlignment="Right" />
                <cc:CommandButton Name="AdminRemarksButton"
                                  Command="adminremarks"
                                  Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}"
                                  StyleClasses="ButtonTerminalBlackM" />
                <!-- BlackM end -->
                <!-- CorvaxGoob-Sponsor-Start -->
                <!-- BlackM start -->
                <!--
                <Button Name="SponsorButton"
                        Text="{Loc 'character-setup-gui-character-setup-sponsor-button'}"
                        Visible="False"
                        StyleClasses="ButtonBig" />
                -->
                <Button Name="SponsorButton"
                        Text="{Loc 'character-setup-gui-character-setup-sponsor-button'}"
                        Visible="False"
                        StyleClasses="ButtonTerminalBlackM" />
                <!-- BlackM end -->
                <!-- CorvaxGoob-Sponsor-End -->
                <!-- BlackM start -->
                <!--
                <Button Name="RulesButton"
                        Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                        StyleClasses="ButtonBig"/>
                <Button Name="CloseButton"
                        Access="Public"
                        Text="{Loc 'character-setup-gui-character-setup-close-button'}"
                        StyleClasses="ButtonBig"/>
                -->
                <Button Name="RulesButton"
                        Text="{Loc 'character-setup-gui-character-setup-rules-button'}"
                        StyleClasses="ButtonTerminalBlackM"/>
                <Button Name="CloseButton"
                        Access="Public"
                        Text="{Loc 'character-setup-gui-character-setup-close-button'}"
                        StyleClasses="ButtonTerminalBlackM"/>
                <!-- BlackM end -->
            </BoxContainer>
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <!-- BlackM start -->
                    <!--
                    <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.NanoGold}" ContentMarginTopOverride="2" />
                    -->
                    <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.TerminalGreenDim}" ContentMarginTopOverride="2" />
                    <!-- BlackM end -->
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="0">
                <ScrollContainer MinSize="325 0" Margin="5 5 0 0">
                    <BoxContainer Name="Characters" Orientation="Vertical" />
                </ScrollContainer>
                <PanelContainer MinSize="2 0">
                    <PanelContainer.PanelOverride>
                        <!-- BlackM start -->
                        <!--
                        <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.NanoGold}" ContentMarginTopOverride="2" />
                        -->
                        <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.TerminalGreenDim}" ContentMarginTopOverride="2" />
                    </PanelContainer.PanelOverride>
                </PanelContainer>
                <BoxContainer Orientation="Vertical" MinSize="240 0" Margin="8 8 8 0" SeparationOverride="6">
                    <Label Text="{Loc 'blackm-setup-sections'}" StyleClasses="LabelTerminalBlackM" Margin="2 0 0 4" />
                    <BoxContainer Name="SectionMenu" Orientation="Vertical" SeparationOverride="6" />
                </BoxContainer>
                <PanelContainer MinSize="2 0">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.TerminalGreenDim}" ContentMarginTopOverride="2" />
                        <!-- BlackM end -->
                    </PanelContainer.PanelOverride>
                </PanelContainer>
                <BoxContainer Name="CharEditor" HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
    </Control>
</Control>
