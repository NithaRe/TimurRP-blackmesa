<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:terminal="clr-namespace:Content.Client._BlackM.Lobby.Terminal">
    <BoxContainer Name="VBox" Orientation="Vertical">
        <Label Name="Header" Visible="False" Text="{Loc 'lobby-character-preview-panel-header'}"
               StyleClasses="LabelTerminalBlackM" />
        <BoxContainer Name="Loaded" Orientation="Vertical" Visible="False">
            <PanelContainer>
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#100C07CC"
                                      BorderColor="{x:Static style:StyleNano.TerminalGreenDim}"
                                      BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="10">
                    <BoxContainer Orientation="Horizontal">
                        <Label Text="{Loc 'blackm-file-title'}" StyleClasses="LabelTerminalBlackM"
                               HorizontalExpand="True" ClipText="True" />
                        <Label Text="{Loc 'blackm-file-status'}" StyleClasses="LabelTerminalBlackM"
                               Modulate="#FFFFFFB0" />
                    </BoxContainer>
                    <PanelContainer MinSize="0 2">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.TerminalGreenDim}" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Button Name="PrevButton" Text="&lt;" StyleClasses="FlatButtonTerminalBlackM"
                                MinSize="40 30" ToolTip="Предыдущий персонаж" />
                        <PanelContainer HorizontalExpand="True">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#FFB52E10" />
                            </PanelContainer.PanelOverride>
                            <Label Name="SlotLabel" StyleClasses="LabelTerminalBlackM" Align="Center"
                                   HorizontalExpand="True" VerticalAlignment="Center" Margin="0 4" />
                        </PanelContainer>
                        <Button Name="NextButton" Text="&gt;" StyleClasses="FlatButtonTerminalBlackM"
                                MinSize="40 30" ToolTip="Следующий персонаж" />
                    </BoxContainer>
                    <BoxContainer Name="ChipRow" Orientation="Horizontal" SeparationOverride="4"
                                  HorizontalAlignment="Center" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="14">
                        <PanelContainer VerticalAlignment="Top">
                            <PanelContainer.PanelOverride>
                                <gfx:StyleBoxFlat BackgroundColor="#241706"
                                                  BorderColor="{x:Static style:StyleNano.TerminalGreen}"
                                                  BorderThickness="2" />
                            </PanelContainer.PanelOverride>
                            <Control Name="PortraitArea" SetSize="150 176" RectClipContent="True"
                                     MouseFilter="Stop" ToolTip="rotate">
                                <Control Name="ViewBox" />
                                <PanelContainer Name="ScanBar" Visible="False" MouseFilter="Ignore"
                                                VerticalAlignment="Top" MinSize="0 3">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#FFD27AD0" />
                                    </PanelContainer.PanelOverride>
                                </PanelContainer>
                                <PanelContainer MouseFilter="Ignore">
                                    <PanelContainer.PanelOverride>
                                        <gfx:StyleBoxFlat BackgroundColor="#FFB52E18" />
                                    </PanelContainer.PanelOverride>
                                </PanelContainer>
                                <terminal:TerminalScanlines LineStep="4" LineAlpha="0.035" RollingBar="False"
                                                            Flicker="False" VignetteStrength="0.015" />
                            </Control>
                        </PanelContainer>
                        <BoxContainer Name="InfoColumn" Orientation="Vertical" VerticalAlignment="Top"
                                      HorizontalExpand="True" SeparationOverride="5">
                            <Label Name="NameLabel" StyleClasses="LabelTerminalBlackM" HorizontalExpand="True"
                                   ClipText="True" />
                            <PanelContainer MinSize="0 1" Margin="0 2 0 2">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.TerminalGreenDim}" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <BoxContainer Orientation="Horizontal" SeparationOverride="14">
                                <BoxContainer Orientation="Vertical">
                                    <Label Name="KeySpecies" StyleClasses="LabelTerminalBlackM" Modulate="#FFFFFF90" />
                                    <Label Name="KeyAge" StyleClasses="LabelTerminalBlackM" Modulate="#FFFFFF90" />
                                    <Label Name="KeySex" StyleClasses="LabelTerminalBlackM" Modulate="#FFFFFF90" />
                                    <Label Name="KeyJob" StyleClasses="LabelTerminalBlackM" Modulate="#FFFFFF90" />
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                                    <Label Name="ValSpecies" StyleClasses="LabelTerminalBlackM" ClipText="True" />
                                    <Label Name="ValAge" StyleClasses="LabelTerminalBlackM" ClipText="True" />
                                    <Label Name="ValSex" StyleClasses="LabelTerminalBlackM" ClipText="True" />
                                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                        <TextureRect Name="JobIcon" Visible="False" TextureScale="2 2"
                                                     Stretch="KeepCentered" VerticalAlignment="Center" />
                                        <Label Name="ValJob" StyleClasses="LabelTerminalBlackM" ClipText="True"
                                               HorizontalExpand="True" />
                                    </BoxContainer>
                                </BoxContainer>
                            </BoxContainer>
                            <PanelContainer MinSize="0 1" Margin="0 2 0 2">
                                <PanelContainer.PanelOverride>
                                    <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.TerminalGreenDim}" />
                                </PanelContainer.PanelOverride>
                            </PanelContainer>
                            <Label Name="Summary" StyleClasses="LabelTerminalBlackM" HorizontalExpand="True"
                                   ClipText="True" Modulate="#FFFFFFB0" />
                            <Label Name="FileId" StyleClasses="LabelTerminalBlackM" Modulate="#FFFFFF60" />
                        </BoxContainer>
                    </BoxContainer>

                    <PanelContainer MinSize="0 1">
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="{x:Static style:StyleNano.TerminalGreenDim}" />
                        </PanelContainer.PanelOverride>
                    </PanelContainer>
                    <terminal:TerminalHub Name="Hub" Access="Public" />
                    <Button Name="CharacterSetup" Visible="False"
                            Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
                            HorizontalAlignment="Center"
                            StyleClasses="ButtonTerminalBlackM" />
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
        <Label Name="Unloaded" StyleClasses="LabelTerminalBlackM"
               Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}"/>
<!-- BlackM end -->
    </BoxContainer>
</Control>
